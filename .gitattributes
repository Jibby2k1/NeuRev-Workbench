# Keep binary scientific artifacts out of text diffs.
paper/**/*.tsv linguist-generated=true -diff
research/run-provenance/**/*.tsv linguist-generated=true -diff -whitespace
*.pdf binary
*.png binary
*.npz binary
*.npy binary
*.tif binary
*.tiff binary
