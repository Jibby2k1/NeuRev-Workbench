%% NeuRev Workbench — incremental experiment lifecycle
%% Semantic source for docs/assets/diagrams/experiment-lifecycle.svg
%% Lifecycle, outcome, evidence tier, decision, and claim state are independent axes.
%%{init: {"theme":"base","themeVariables":{"fontFamily":"Inter, ui-sans-serif, system-ui, sans-serif","primaryColor":"#ddf4f5","primaryTextColor":"#102733","primaryBorderColor":"#147d87","lineColor":"#607b87","secondaryColor":"#e8eefb","tertiaryColor":"#f0eafa","clusterBkg":"#f7fafb","clusterBorder":"#b9cad1"},"flowchart":{"curve":"basis","htmlLabels":true}}}%%
flowchart TB
  subgraph LIFE["LIFECYCLE — THE AUDITABLE SEQUENCE"]
    direction LR
    DRAFT["<b>Draft</b><br/>Question + falsifier"]
    FROZEN["<b>Preregistered</b><br/>Protocol frozen"]
    RUNNING["<b>Running</b><br/>Bounded execution"]
    COMPUTED["<b>Computed</b><br/>Artifacts present"]
    VALIDATED["<b>Validated</b><br/>Gates checked"]
    REVIEWED["<b>Reviewed</b><br/>Interpretation recorded"]
    CLOSED["<b>Closed</b><br/>Decision durable"]
    DRAFT -->|freeze| FROZEN -->|execute| RUNNING -->|inventory| COMPUTED -->|validate| VALIDATED -->|review| REVIEWED -->|record| CLOSED
  end

  subgraph AXES["COMPLETION HAS MULTIPLE INDEPENDENT AXES"]
    direction TB
    OUTCOME["<b>Outcome</b> · supported · rejected · mixed · inconclusive"]
    TIER["<b>Evidence tier</b> · descriptive · current recording · simulation · external · independent recording"]
    DECISION["<b>Decision</b> · promote · retain · hold · stop · supersede"]
    CLAIM["<b>Claim state</b> · proposed · provisional · supported · contradicted · retired"]
  end

  VALIDATED --> AXES
  AXES --> PASS["<b>Gate passes</b><br/>Commit evidence capsule"]
  AXES -.-> FAIL["<b>Gate fails</b><br/>Preserve result; open a new version or run"]
  PASS --> STORY["<b>Regenerate every story view</b><br/>GitHub · docs · Overleaf · LLM indexes"]
  FAIL -.-> DRAFT

  classDef lifecycle fill:#ffffff,stroke:#147d87,color:#102733,stroke-width:1.5px;
  classDef axes fill:#e8eefb,stroke:#3158a5,color:#102733,stroke-width:1.25px;
  classDef decision fill:#f0eafa,stroke:#6e53a4,color:#102733,stroke-width:1.5px;
  classDef failure fill:#ffffff,stroke:#a74760,color:#102733,stroke-width:1.5px,stroke-dasharray:5 4;
  class DRAFT,FROZEN,RUNNING,COMPUTED,VALIDATED,REVIEWED,CLOSED lifecycle;
  class OUTCOME,TIER,DECISION,CLAIM axes;
  class PASS,STORY decision;
  class FAIL failure;
