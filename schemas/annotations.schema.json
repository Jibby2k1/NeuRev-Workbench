{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "pixelPoint": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "cfarRegion": {
      "type": "object",
      "required": ["schema_version", "foreground_points", "background_points", "reference_frames", "provenance"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "foreground_points": {"type": "array", "items": {"$ref": "#/$defs/pixelPoint"}, "uniqueItems": true},
        "background_points": {"type": "array", "items": {"$ref": "#/$defs/pixelPoint"}, "uniqueItems": true},
        "reference_frames": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
        "provenance": {"type": "string", "minLength": 1},
        "updatedAt": {"type": "string"},
        "last_edit": {"type": "object"},
        "edit_history": false
      },
      "additionalProperties": true
    },
    "runBucket": {
      "type": "object",
      "properties": {
        "rois": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {"cfar_regions": {"$ref": "#/$defs/cfarRegion"}},
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "title": "Neurobench Annotations",
  "type": "object",
  "required": ["schema_version", "rois", "events", "suggestions", "settings"],
  "properties": {
    "schema_version": {"type": "integer", "const": 3},
    "updatedAt": {"type": ["string", "null"]},
    "rois": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "state": {"type": "string"},
          "cell_state": {"type": "string", "enum": ["", "accepted", "rejected", "unsure"]},
          "trace_quality": {"type": "string", "enum": ["", "good", "weak", "noisy", "unusable"]},
          "control_ready": {"type": "string", "enum": ["", "yes", "no", "maybe"]},
          "artifact_class": {"type": "string"},
          "identity_group": {"type": "string"},
          "needs_action": {"type": "string"},
          "reason_tags": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "string", "enum": ["", "low", "medium", "high"]},
          "reviewer_id": {"type": "string"},
          "updatedAt": {"type": "string"},
          "deleted": {"type": "boolean"},
          "notes": {"type": "string"},
          "cfar_regions": {"$ref": "#/$defs/cfarRegion"}
        },
        "additionalProperties": true
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "state": {"type": "string"},
          "event_state": {"type": "string", "enum": ["", "accepted", "rejected", "unsure"]},
          "event_type": {"type": "string"},
          "timing_quality": {"type": "string", "enum": ["", "clear_frame", "ambiguous", "slow_transient"]},
          "reason_tags": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "string", "enum": ["", "low", "medium", "high"]},
          "reviewer_id": {"type": "string"},
          "updatedAt": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "suggestions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "state": {"type": "string"},
          "reason_tags": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "string", "enum": ["", "low", "medium", "high"]},
          "reviewer_id": {"type": "string"},
          "updatedAt": {"type": "string"},
          "notes": {"type": "string"},
          "cfar_regions": {"$ref": "#/$defs/cfarRegion"}
        },
        "additionalProperties": true
      }
    },
    "promotedRois": {"type": "object"},
    "virtualRois": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "roi_kind": {"type": "string"},
          "source_roi_ids": {"type": "array", "items": {"type": ["integer", "string"]}},
          "identity_group": {"type": "string"},
          "cell_state": {"type": "string"},
          "trace_quality": {"type": "string"},
          "control_ready": {"type": "string"},
          "artifact_class": {"type": "string"},
          "reason_tags": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "string", "enum": ["", "low", "medium", "high"]},
          "reviewer_id": {"type": "string"},
          "updatedAt": {"type": "string"},
          "notes": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "splitMergeDecisions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["decision_type", "source_roi_ids"],
        "properties": {
          "id": {"type": "string"},
          "decision_type": {"type": "string", "enum": ["", "split", "merge"]},
          "decision_state": {"type": "string", "enum": ["", "proposed", "accepted", "rejected", "unsure"]},
          "source_roi_ids": {"type": "array", "items": {"type": ["integer", "string"]}},
          "target_roi_ids": {"type": "array", "items": {"type": ["integer", "string"]}},
          "virtual_roi_id": {"type": "string"},
          "identity_group": {"type": "string"},
          "needs_action": {"type": "string"},
          "reason_tags": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "string", "enum": ["", "low", "medium", "high"]},
          "notes": {"type": "string"},
          "createdAt": {"type": "string"},
          "reviewer_id": {"type": "string"},
          "updatedAt": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "reviewStats": {
      "type": "object",
      "properties": {
        "sessionStartedAt": {"type": ["string", "null"]},
        "lastActionAt": {"type": ["string", "null"]},
        "actions": {"type": "object", "additionalProperties": {"type": "integer"}}
      },
      "additionalProperties": true
    },
    "runs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/runBucket"}},
    "settings": {"type": "object"}
  },
  "additionalProperties": true
}
